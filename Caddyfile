vlad2hard.ru, www.vlad2hard.ru {
  encode gzip

  handle /api/* {
    reverse_proxy api:3000
  }

  root * /srv

  # Serve real assets normally. Every other client-side route must return
  # the SPA shell so refreshing /lesson/... or /editor/... never becomes 404.
  @static file
  handle @static {
    file_server
  }

  handle {
    rewrite * /index.html
    file_server
  }
}
